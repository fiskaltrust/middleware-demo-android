<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ================= DEMO TAB ================= -->
            <LinearLayout
                android:id="@+id/demoSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Protocol: "
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtCurrentProtocol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INTENT-ACTIVITY"
                        android:textStyle="bold"
                        android:textColor="@color/primary_purple"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  → Change in Settings"
                        android:textColor="#888888"
                        android:textSize="12sp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnRetryLastOperation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔄 Retry Last Operation"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="@color/success_green"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_gray"
                    android:layout_marginVertical="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSendEchoRequest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/primary_purple"
                        android:textColor="#FFFFFF"
                        android:text="Send Echo Request"/>

                    <Button
                        android:id="@+id/btnRestartConfig"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/danger_red"
                        android:textColor="#FFFFFF"
                        android:text="Restart &amp; Pull Config"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Echo result:"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/txtResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnSendStartReceipt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/primary_purple"
                        android:textColor="#FFFFFF"
                        android:text="Send start receipt"/>

                    <Button
                        android:id="@+id/btnSendZeroReceipt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/primary_purple"
                        android:textColor="#FFFFFF"
                        android:text="Send zero receipt"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Special receipt result:"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/txtSpecialReceiptResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""/>

                <Button
                    android:id="@+id/btnSendSignRequest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/primary_purple"
                    android:textColor="#FFFFFF"
                    android:text="Send Sign Request"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sign result:"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/txtSignResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""/>
            </LinearLayout>

            <!-- ================= SETTINGS TAB ================= -->
            <LinearLayout
                android:id="@+id/settingsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Credentials"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#F5F5F5"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pairing PIN"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enter the PIN shown in the fiskaltrust.Portal to automatically retrieve your Cashbox ID and Access Token."
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/entryPairPin"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="number"
                            android:maxLength="4"
                            android:hint="0000"/>

                        <Button
                            android:id="@+id/btnPair"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pair"
                            android:enabled="false"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pairingStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        android:layout_marginTop="8dp">

                        <ProgressBar
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pairing…"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#F5F5F5"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cashbox ID"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/entryCashboxId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Access Token"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/entryAccessToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Communication Protocol"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <RadioGroup
                    android:id="@+id/radioGroupProtocol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#F5F5F5"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp">

                    <RadioButton
                        android:id="@+id/radioIntentActivity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Intent-Activity"
                        android:checked="true"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Start launcher PosSystemAPI Activity for request/response"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:paddingStart="32dp"
                        android:layout_marginBottom="12dp"/>

                    <RadioButton
                        android:id="@+id/radioServiceIpc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Service-IPC (Bound)"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Use bound IPC (Messenger) to call launcher PosSystemAPIService"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:paddingStart="32dp"/>
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/info_blue_bg"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ℹ️ About Protocols"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:text="Intent-Activity starts the launcher's PosSystemAPI Activity for each request/response. Service-IPC (Bound) uses a bound Android service with Messenger IPC instead."/>
                </LinearLayout>
            </LinearLayout>

            <!-- ================= ABOUT TAB ================= -->
            <LinearLayout
                android:id="@+id/aboutSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="fiskaltrust.Middleware Demo"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Version 1.0"
                    android:textColor="#888888"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#F5F5F5"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="About This App"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="This is a sample application demonstrating the fiskaltrust.Middleware usage on Android."/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/info_blue_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📡 Communication Protocols"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Intent-based: uses the Android Intent system for inter-app communication.\n\nMessage-based: uses an Android Bound Service with Messages for inter-app communication.\n\nChange the protocol in the Settings tab."/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/info_orange_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⏱ Service Information"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Starting the service might take up to 45 seconds, depending on the TSE, as it includes a self-test for Swissbit. The state of the service is displayed in the notification."/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/info_green_bg"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✓ Requirements"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Make sure the fiskaltrust launcher app is installed and running on your device."/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_gray"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:elevation="4dp">

        <LinearLayout
            android:id="@+id/tabDemo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/txtTabDemo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶  Demo"
                android:textSize="13sp"/>

            <View
                android:id="@+id/indicatorDemo"
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:background="@color/primary_purple"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/txtTabSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙  Settings"
                android:textSize="13sp"/>

            <View
                android:id="@+id/indicatorSettings"
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:background="@color/primary_purple"
                android:visibility="invisible"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabAbout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/txtTabAbout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ  About"
                android:textSize="13sp"/>

            <View
                android:id="@+id/indicatorAbout"
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:background="@color/primary_purple"
                android:visibility="invisible"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
