<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fiskaltrust.Middleware.Demo.SettingsPage"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="20">

            <Label Text="Credentials"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,10,0,0"/>

            <Border StrokeThickness="1"
                    Stroke="LightGray"
                    BackgroundColor="White"
                    Padding="15"
                    Margin="0,0,0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Cashbox ID"
                           FontAttributes="Bold"
                           FontSize="14"/>
                    <Entry x:Name="entryCashboxId"
                           Placeholder="00000000-0000-0000-0000-000000000000"
                           TextChanged="OnCashboxIdChanged"/>

                    <Label Text="Access Token"
                           FontAttributes="Bold"
                           FontSize="14"
                           Margin="0,10,0,0"/>
                    <Entry x:Name="entryAccessToken"
                           Placeholder="Access token"
                           IsPassword="True"
                           TextChanged="OnAccessTokenChanged"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Communication Protocol"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,10,0,0"/>

            <Border StrokeThickness="1"
                    Stroke="LightGray"
                    BackgroundColor="White"
                    Padding="15"
                    Margin="0,0,0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout>
                        <RadioButton x:Name="radioIntentActivity"
                                     Content="Intent-Activity"
                                     GroupName="CommType"
                                     FontAttributes="Bold"
                                     FontSize="16"
                                     CheckedChanged="OnProtocolChanged"/>
                        <Label Text="Start launcher PosSystemAPI Activity for request/response"
                               FontSize="12"
                               TextColor="Gray"
                               Margin="30,0,0,0"/>
                    </VerticalStackLayout>

                    <BoxView Color="LightGray"
                             HeightRequest="1"/>

                    <VerticalStackLayout>
                        <RadioButton x:Name="radioIntentService"
                                     Content="Service IPC (Bound)"
                                     GroupName="CommType"
                                     FontAttributes="Bold"
                                     FontSize="16"
                                     CheckedChanged="OnProtocolChanged"/>
                        <Label Text="Use bound IPC (Messenger) to call launcher PosSystemAPIService"
                               FontSize="12"
                               TextColor="Gray"
                               Margin="30,0,0,0"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1"
                    Stroke="#E3F2FD"
                    BackgroundColor="#E3F2FD"
                    Padding="15"
                    Margin="0,10,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="5">
                    <Label Text="ℹ️ About Protocols"
                           FontAttributes="Bold"
                           FontSize="14"/>
                    <Label FontSize="12"
                           LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="The selected protocol determines how this app communicates with the fiskaltrust.Middleware service.&#x0a;&#x0a;"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
